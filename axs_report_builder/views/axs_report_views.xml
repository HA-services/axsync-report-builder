<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- column form (opened from the report) -->
    <record id="axs_report_line_view_form" model="ir.ui.view">
        <field name="name">axs.report.line.form</field>
        <field name="model">axs.report.line</field>
        <field name="arch" type="xml">
            <form string="Column">
                <sheet>
                    <field name="query_type" invisible="1"/>
                    <field name="model_id" invisible="1"/>
                    <field name="level1_model_id" invisible="1"/>
                    <field name="level2_model_id" invisible="1"/>
                    <field name="level3_model_id" invisible="1"/>
                    <field name="level4_model_id" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h2><field name="name" placeholder="e.g. Customer Country"/></h2>
                    </div>
                    <group string="Data" invisible="query_type != 'field_chain'">
                        <group>
                            <field name="level1_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="level2_id" options="{'no_create': True, 'no_open': True}"
                                   invisible="not level1_model_id"/>
                            <field name="level3_id" options="{'no_create': True, 'no_open': True}"
                                   invisible="not level2_model_id or not level2_id"/>
                            <field name="level4_id" options="{'no_create': True, 'no_open': True}"
                                   invisible="not level3_model_id or not level3_id"/>
                            <field name="level5_id" options="{'no_create': True, 'no_open': True}"
                                   invisible="not level4_model_id or not level4_id"/>
                        </group>
                        <group>
                            <field name="field_chain" placeholder="partner_id.country_id.name"/>
                            <field name="x2many_mode"/>
                        </group>
                    </group>
                    <group string="Data" invisible="query_type != 'custom_query'">
                        <field name="sql_column"/>
                        <field name="relation_model_id" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <group string="Display">
                            <field name="result_type"/>
                            <field name="field_name"/>
                            <field name="list_visible"/>
                            <field name="aggregator"/>
                            <field name="alter_op"/>
                            <field name="alter_value" invisible="alter_op in ('none', 'abs', 'negate', 'trunc_week', 'trunc_month', 'trunc_quarter', 'trunc_year')"/>
                        </group>
                        <group string="Filters and Analysis">
                            <field name="search_filter"/>
                            <field name="group_filter"/>
                            <field name="default_group"/>
                            <field name="pivot_role"/>
                            <field name="graph_role"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="axs_report_view_form" model="ir.ui.view">
        <field name="name">axs.report.form</field>
        <field name="model">axs.report</field>
        <field name="arch" type="xml">
            <form string="Report">
                <header>
                    <button name="action_run_query" type="object" string="Run Query" class="btn-primary"
                            invisible="query_type != 'custom_query'"/>
                    <button name="action_preview" type="object" string="Preview"/>
                    <button name="action_publish" type="object" string="Publish" class="btn-primary"
                            invisible="state == 'published'"/>
                    <button name="action_publish" type="object" string="Update Menu and Views"
                            invisible="state != 'published'"/>
                    <button name="action_open_report" type="object" string="Open Report" class="btn-primary"
                            invisible="state != 'published'"/>
                    <button name="action_unpublish" type="object" string="Unpublish"
                            invisible="state != 'published'"/>
                    <button name="action_export_definition" type="object" string="Export Definition"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Sales by Country"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="query_type" widget="radio" options="{'horizontal': true}"/>
                            <field name="model_id" options="{'no_create': True}"
                                   invisible="query_type != 'field_chain'" required="query_type == 'field_chain'"/>
                            <field name="base_model" invisible="1"/>
                            <field name="model_name" invisible="not model_name"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group invisible="query_type != 'field_chain'">
                        <field name="domain" widget="domain" options="{'model': 'base_model', 'in_dialog': true}"
                               invisible="not model_id"/>
                        <field name="include_archived"/>
                        <field name="apply_record_rules"/>
                    </group>
                    <group invisible="query_type != 'custom_query'">
                        <field name="query_text" nolabel="1" colspan="2" class="font-monospace"
                               placeholder="SELECT partner.name AS customer, SUM(so.amount_total) AS total&#10;FROM sale_order so JOIN res_partner partner ON partner.id = so.partner_id&#10;WHERE so.company_id IN {{company_ids}}&#10;GROUP BY partner.name"/>
                    </group>
                    <notebook>
                        <page string="Columns" name="columns">
                            <field name="line_ids" context="{'default_report_id': id}">
                                <tree>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="field_chain" column_invisible="parent.query_type == 'custom_query'"/>
                                    <field name="sql_column" column_invisible="parent.query_type != 'custom_query'"/>
                                    <field name="result_type"/>
                                    <field name="search_filter" widget="boolean_toggle"/>
                                    <field name="group_filter" widget="boolean_toggle"/>
                                    <field name="aggregator"/>
                                    <field name="alter_op"/>
                                    <field name="pivot_role" optional="hide"/>
                                    <field name="graph_role" optional="hide"/>
                                    <field name="list_visible" optional="hide"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Menu and Access" name="menu">
                            <group>
                                <group string="Menu">
                                    <field name="menu_name" placeholder="Same as the report name"/>
                                    <field name="parent_menu_id" options="{'no_create': True}"/>
                                    <field name="menu_sequence"/>
                                    <field name="menu_id" invisible="not menu_id"/>
                                </group>
                                <group string="Who can open it">
                                    <field name="group_ids" widget="many2many_tags" options="{'no_create': True}"
                                           placeholder="Every internal user"/>
                                </group>
                            </group>
                            <group string="Description">
                                <field name="description" nolabel="1" colspan="2"
                                       placeholder="Shown to users when the report has no data."/>
                            </group>
                        </page>
                        <page string="Views" name="views">
                            <group>
                                <group string="List">
                                    <field name="default_view"/>
                                    <field name="order_line_id" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="order_desc"/>
                                </group>
                                <group string="Pivot and Graph">
                                    <field name="show_pivot"/>
                                    <field name="show_graph"/>
                                    <field name="graph_type" invisible="not show_graph"/>
                                    <field name="graph_stacked" invisible="not show_graph"/>
                                </group>
                            </group>
                        </page>
                        <page string="Scheduled Email" name="email">
                            <group>
                                <group>
                                    <field name="email_enabled"/>
                                    <field name="email_interval" invisible="not email_enabled"/>
                                    <field name="email_next" invisible="not email_enabled"/>
                                    <field name="email_row_limit" invisible="not email_enabled"/>
                                    <field name="email_last_sent" invisible="not email_last_sent"/>
                                </group>
                                <group>
                                    <field name="email_partner_ids" widget="many2many_tags"/>
                                    <button name="action_send_email" type="object" string="Send Now" colspan="2"
                                            invisible="state != 'published'"/>
                                </group>
                            </group>
                        </page>
                        <page string="Preview" name="preview">
                            <field name="preview_html" nolabel="1"/>
                            <div class="text-muted" invisible="preview_html">Click Preview to see the first rows.</div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="axs_report_view_list" model="ir.ui.view">
        <field name="name">axs.report.list</field>
        <field name="model">axs.report</field>
        <field name="arch" type="xml">
            <tree string="Reports">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="query_type"/>
                <field name="model_id"/>
                <field name="parent_menu_id"/>
                <field name="group_ids" widget="many2many_tags"/>
                <field name="email_enabled" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'published'"/>
            </tree>
        </field>
    </record>

    <record id="axs_report_view_search" model="ir.ui.view">
        <field name="name">axs.report.search</field>
        <field name="model">axs.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="model_id"/>
                <filter name="published" string="Published" domain="[('state', '=', 'published')]"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="scheduled" string="Sent by Email" domain="[('email_enabled', '=', True)]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="gb_type" string="Query Type" context="{'group_by': 'query_type'}"/>
                    <filter name="gb_model" string="Model" context="{'group_by': 'model_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_axs_report" model="ir.actions.act_window">
        <field name="name">Report Builder</field>
        <field name="res_model">axs.report</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Build your first report</p>
            <p>Pick a model and the fields you need, even from related records, or write a SQL query.
                The report gets its own menu with list, pivot and graph views.</p>
        </field>
    </record>

    <record id="axs_report_import_view_form" model="ir.ui.view">
        <field name="name">axs.report.import.form</field>
        <field name="model">axs.report.import</field>
        <field name="arch" type="xml">
            <form string="Import Report Definitions">
                <p class="text-muted">Upload a file created with Export Definition in another database.</p>
                <group>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                    <field name="publish"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Import" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_axs_report_import" model="ir.actions.act_window">
        <field name="name">Import Definitions</field>
        <field name="res_model">axs.report.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_reports_root" name="Reports" sequence="90" groups="base.group_user"
              web_icon="axs_report_builder,static/description/icon.png"/>
    <menuitem id="menu_report_builder_config" name="Report Builder" parent="menu_reports_root" sequence="1000"
              groups="group_report_manager"/>
    <menuitem id="menu_axs_report" name="Reports" parent="menu_report_builder_config" sequence="10"
              action="action_axs_report"/>
    <menuitem id="menu_axs_report_import" name="Import Definitions" parent="menu_report_builder_config" sequence="20"
              action="action_axs_report_import"/>
</odoo>
